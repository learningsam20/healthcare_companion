{
  "llm": {
    "provider": "openai",
    "config": {
      "model": "qwen2.5:3b-instruct-q4_K_M",
      "temperature": 0.1,
      "max_tokens": 2000,
      "api_key": "env:OPENAI_API_KEY",
      "openai_base_url": "http://litellm:4000/v1"
    }
  },
  "embedder": {
    "provider": "openai",
    "config": {
      "model": "bge-m3",
      "api_key": "env:OPENAI_API_KEY",
      "openai_base_url": "http://litellm:4000/v1"
    }
  },
  "vector_store": {
    "provider": "pgvector",
    "config": {
      "host": "mem0-postgres",
      "port": 5432,
      "user": "mem0",
      "password": "mem0",
      "dbname": "mem0",
      "embedding_model_dims": 1024
    }
  },
  "graph_store": {
    "provider": "neo4j",
    "config": {
      "url": "bolt://mem0-neo4j:7687",
      "username": "neo4j",
      "password": "mem0graph"
    }
  }
}
