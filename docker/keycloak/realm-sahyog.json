{
  "realm": "sahyog",
  "displayName": "Sahyog Care Companion",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 8,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "hi", "mr"],
  "defaultLocale": "en",
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      {"name": "patient", "description": "Patient using their own records and chat"},
      {"name": "caregiver", "description": "Caregiver with patient-granted consent"},
      {"name": "doctor", "description": "Doctor with scoped clinical access"},
      {"name": "front_desk", "description": "Front desk with scheduling and demographic access"},
      {"name": "pharmacist", "description": "Pharmacist with medicine and stock access"},
      {"name": "compliance", "description": "Compliance officer with audit metadata access"},
      {"name": "admin", "description": "Platform administrator"},
      {"name": "service", "description": "Service identity for automation"}
    ]
  },
  "clients": [
    {
      "clientId": "sahyog-web",
      "name": "Sahyog Care Companion web",
      "description": "Public SPA client using Authorization Code with PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:5705",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5705/*",
        "http://localhost:5729/*"
      ],
      "webOrigins": [
        "http://localhost:5705",
        "http://localhost:5729"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5705/*##http://localhost:5729/*##http://127.0.0.1:5705/*##http://127.0.0.1:5729/*",
        "frontchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "sahyog-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sahyog-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "patient-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "patient_id",
            "claim.name": "patient_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "clinic-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clinic_ids",
            "claim.name": "clinic_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "locale",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "locale",
            "claim.name": "locale",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "traffic-class",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "traffic_class",
            "claim.name": "traffic_class",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "doctor-display-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "doctor_display_name",
            "claim.name": "doctor_display_name",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "sahyog-api",
      "name": "Sahyog Care Companion API",
      "description": "Bearer-only resource server audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false
    }
  ],
  "users": []
}
