# Sahyog Care Companion — example environment.
# Copy to .env and replace every placeholder. Prefer a vault in any shared environment.
# Secrets never belong in YAML, the repository, container images or the frontend.

# ---------------------------------------------------------------- application
APP_NAME=Sahyog Care Companion
APP_ENV=dev                      # dev | staging | production
APP_PROFILE=minimal              # minimal | core | full
APP_BASE_URL=http://localhost:5705
API_BASE_URL=http://localhost:5706
CORS_ORIGINS=http://localhost:5705,http://localhost:5729
LOG_LEVEL=INFO
TZ=Asia/Kolkata
APP_SECRET_KEY=replace-with-32-plus-random-bytes
SUPPORTED_LOCALES=en-IN,hi-IN,mr-IN
DEFAULT_LOCALE=en-IN
LANGUAGE_DETECTION_ENABLED=true

# --------------------------------------------------------------- host ports
# Every host-facing port uses the 57xx block, numbered sequentially. Container
# ports are unchanged (web:80, api:8000, keycloak:8080, postgres:5432, ...) so
# Compose service discovery and the application config do not change.
WEB_PORT=5705             # SPA
API_PORT=5706             # FastAPI
KEYCLOAK_PORT=5707        # Keycloak
LITELLM_PORT=5708         # LiteLLM proxy
MCP_BROKER_PORT=5709
MCP_SCHEDULING_PORT=5710
MCP_RECORDS_PORT=5711
MCP_CLINICAL_PORT=5712
MCP_PLATFORM_PORT=5713
MCP_DECIDER_PORT=5714
MCP_PII_PORT=5715
MCP_STT_PORT=5716
SMTP_CAPTURE_PORT=5717    # Mailpit SMTP sink
MAILPIT_UI_PORT=5718
S3_PORT=5719              # S3Proxy API (path-style, aws-v4)
LANGFUSE_PORT=5721
PROMETHEUS_PORT=5722
GRAFANA_PORT=5723
POSTGRES_PORT=5724
REDIS_PORT=5725
EGRESS_PROXY_PORT=5726
CLICKHOUSE_HTTP_PORT=5727
OLLAMA_PORT=5728          # opt-in compose profile `ollama` only; host daemon uses 11434
VITE_DEV_PORT=5729        # Vite HMR dev server
MEM0_PORT=5730            # Self-hosted Mem0 API
MEM0_NEO4J_HTTP_PORT=5731  # Mem0 Neo4j browser
MEM0_NEO4J_BOLT_PORT=5732  # Mem0 Neo4j Bolt
DECIDER_LLAMA_PORT=5733    # OpenDecider llama.cpp server
MCP_EXTERNAL_PORT=5734     # External read-only MCP demo

# ------------------------------------------------------------------- database
# Postgres 16+ with pgvector is the only supported engine. No SQLite URL is accepted.
# Compose derives DATABASE_URL from POSTGRES_* so the two cannot drift; this value is
# used by host-run tooling (scripts/dev.sh overrides the host to localhost).
POSTGRES_USER=sahyog
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=sahyog
DATABASE_URL=postgresql+asyncpg://sahyog:replace-me@postgres:5432/sahyog
DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=5
PG_SHARED_BUFFERS=1GB
EMBEDDING_DIM=1024
# Separate roles/databases on the same cluster (created once by docker/postgres/init.sh).
LITELLM_DB_PASSWORD=replace-me
LANGFUSE_DB_PASSWORD=replace-me
KEYCLOAK_DB_PASSWORD=replace-me

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0
ARQ_WORKER_QUEUE=sahyog:worker
ARQ_SCHEDULER_QUEUE=sahyog:scheduler

# ------------------------------------------------------------------- keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:5707
KEYCLOAK_REALM=sahyog
KEYCLOAK_CLIENT_ID=sahyog-api
KEYCLOAK_AUDIENCE=sahyog-api
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me
KEYCLOAK_ADMIN_CLIENT_ID=sahyog-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
KEYCLOAK_WEB_CLIENT_ID=sahyog-web
# Local/acceptance only: confidential password-grant client used by operator scripts
# (smoke, exports, load test bootstrap). Every call is still a real Keycloak token.
KEYCLOAK_CLI_CLIENT_ID=sahyog-cli
KEYCLOAK_CLI_CLIENT_SECRET=replace-me
KEYCLOAK_MCP_CLIENT_ID=sahyog-mcp
KEYCLOAK_MCP_CLIENT_SECRET=replace-me
SEED_DEMO_PASSWORD=replace-me-with-12-plus-chars
ADD_USER_PASSWORD=replace-me-with-12-plus-chars

# ------------------------------------------------------------------- storage
# Local stack uses S3Proxy (filesystem) with aws-v4 auth. Never set
# S3PROXY_AUTHORIZATION=none. Production uses a managed S3 service.
S3_ENDPOINT_URL=http://s3proxy:80
S3_PUBLIC_ENDPOINT_URL=http://localhost:5719
S3_REGION=us-east-1
# App credentials = S3Proxy identity/credential (aws-v4).
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_DOCUMENTS=sahyog-documents
S3_BUCKET_AUDIO=sahyog-audio
S3_BUCKET_EXPORTS=sahyog-exports
S3_BUCKET_ANCHORS=sahyog-audit-anchors
# Empty for local S3Proxy; set AES256 when the object store supports SSE-S3.
S3_SERVER_SIDE_ENCRYPTION=
S3_BUCKET_EVAL=sahyog-eval
S3_BUCKET_BACKUPS=sahyog-backups
S3_USE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=300

# ------------------------------------------------------------ malware scanning
# start.sh sets CLAMAV_HOST=clamav and MALWARE_SCAN_MODE=required for the full
# profile unless they are set explicitly. An empty host disables scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310
# required: reject uploads when the scanner is unavailable; advisory: record the
# verdict but accept when ClamAV is down. Never use advisory for patient uploads.
MALWARE_SCAN_MODE=advisory

# ---------------------------------------------------------- model gateway (LiteLLM)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-a-long-random-key
LITELLM_DATABASE_URL=postgresql://litellm:replace-me@postgres:5432/litellm
MODEL_ROUTES_CONFIG=config/models.yaml
OPENROUTER_API_KEY=
# Host-installed Ollama. scripts/start.sh does not start an Ollama container.
# The compose profile `ollama` is opt-in only; do not run it beside this daemon.
# Memory cap (G-49): keep physical RSS ~≤16GiB — run scripts/ollama-memory-cap.sh
# (sets OLLAMA_CONTEXT_LENGTH=8192, OLLAMA_MAX_LOADED_MODELS=1). Virtual size may be larger.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# LiteLLM replaces the whole model value, so keep the provider prefix.
OLLAMA_CHAT_MODEL=ollama_chat/qwen2.5:7b-instruct-q4_K_M
OLLAMA_SMALL_MODEL=ollama_chat/qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=bge-m3
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EXTERNAL_EGRESS_ENABLED=false

# --------------------------------------------------------------- MCP services
MCP_BROKER_URL=http://mcp-broker:8100
MCP_SCHEDULING_URL=http://mcp-scheduling:8101
MCP_RECORDS_URL=http://mcp-records:8102
MCP_CLINICAL_URL=http://mcp-clinical:8103
MCP_PLATFORM_URL=http://mcp-platform:8104
MCP_DECIDER_URL=http://mcp-decider:8105
MCP_PII_URL=http://mcp-pii:8106
MCP_STT_URL=http://mcp-stt:8107
MCP_SERVICE_TOKEN=replace-with-service-token
MCP_CONTEXT_SECRET=replace-with-32-plus-random-bytes
MCP_CONTEXT_TTL_SECONDS=120
MCP_OUTPUT_CHAR_CAP=12000

# --------------------------------------------------------------- privacy / models
PII_ENGINE=composite
PII_FAIL_CLOSED=true
PII_TOKEN_SECRET=replace-with-32-plus-random-bytes
PII_SCORE_THRESHOLD=0.65
PRESIDIO_ENABLED=true
GLINER_ENABLED=true
PRIVACY_FILTER_ENABLED=true
DECIDER_ADAPTER=mcp
STT_ADAPTER=local
STT_MODEL=small
STT_COMPUTE_TYPE=int8
# Cloud STT is fail-closed. Requires privacy/egress approval, composite PII gate,
# EXTERNAL_EGRESS_ENABLED=true, ALLOW_CLOUD_STT=true, STT_ADAPTER=cloud, and
# an OpenAI-compatible transcription endpoint (STT_CLOUD_*).
ALLOW_CLOUD_STT=false
STT_CLOUD_BASE_URL=
STT_CLOUD_API_KEY=
STT_CLOUD_MODEL=whisper-1
# HA_MODE=true makes /readyz require the LangGraph Postgres checkpointer.
# App multi-replica only — not multi-region data-plane HA.
HA_MODE=false
CHECKPOINTER_REQUIRED=false

# ----------------------------------------------------------------- integrations
# Read-only FHIR R4. Base URL alone works for open test servers (e.g. HAPI).
# For HIS OAuth, set CLIENT_ID, CLIENT_SECRET and TOKEN_URL together.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_TOKEN_URL=
FHIR_TIMEOUT_SECONDS=15
# Sandbox-only ABDM readiness seam; never point this at a production ABDM host.
# Local official-path stub (Compose service abdm-stub). Not NHA sandbox credentials.
# ABDM_SANDBOX_URL=http://abdm-stub:8090
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_TIMEOUT_SECONDS=15
# FEATURE_ABDM_LINK=false
# Equality matrix: docs/abdm-stub-equality.md
# Compose HA (nginx api-lb + scale api=2): docs/ha-compose.md
ALERTMANAGER_PORT=5736
# OPENDECIDER_REQUIRED=false
# OPENDECIDER_GGUF=/models/opendecider/model.gguf
# Prefer host Ollama OpenDecider (already pulled) over HF GGUF. Optional Strands fallback:
# DECIDER_BACKEND=auto|opendecider|ollama|strands
# DECIDER_MODEL=tev1:0.8b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# STRANDS_DECIDER_URL=http://host.docker.internal:8000
# STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
STOCK_ADAPTER=api
STOCK_SOURCE_PATH=config/stock.csv
STOCK_STALE_AFTER_MINUTES=60
# Shared by mcp-clinical → GET /api/v1/pharmacy/stock/lookup (X-Stock-Api-Key).
STOCK_API_KEY=
# Scheduled ARQ ops.backup (daily 04:05). Empty → job_runs failed with backup_unconfigured.
# Use a host path outside the repo; in-container Docker often unavailable — see docs/runbooks/backup-and-stock.md.
BACKUP_OUT_DIR=
# Shared MCP→API key for scheduling/records/stock internal tools (falls back to STOCK_API_KEY).
INTERNAL_API_KEY=
SAHYOG_API_URL=http://api:8000
# SMS: use twilio (Messages API) or http (generic Bearer JSON).
SMS_ADAPTER=twilio
SMS_BASE_URL=
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=
SMS_FROM_NUMBER=
SMS_TEST_TO=
FEATURE_NOTIFICATIONS_SMS=false

# Self-hosted Mem0 (docker compose profile core) → LiteLLM → Ollama/llama-server
# Host ports: MEM0_PORT / MEM0_NEO4J_* / DECIDER_LLAMA_PORT / MCP_EXTERNAL_PORT (see ports block above).
MEM0_URL=http://mem0:8000
MEM0_POSTGRES_PASSWORD=mem0
MEM0_NEO4J_PASSWORD=mem0graph
MEM0_OPENAI_BASE_URL=http://litellm:4000/v1
FEATURE_MEMORY_PREFERENCES=false

# Local model weights (scripts/download_models.sh)
WHISPER_MODEL_DIR=./data/models/whisper/faster-whisper-small
GLINER_MODEL=./data/models/gliner-pii/gliner-pii-large-v1.0
DECIDER_MODEL_PATH=./data/models/opendecider/model.gguf
DECIDER_LLAMA_URL=http://litellm:4000
DECIDER_BACKEND=auto
DECIDER_MODEL=tev1:0.8b
# Alt HF GGUF (~234MB): OPENDECIDER_GGUF=/models/opendecider/opendecider-small-td-q4_k_m.gguf
OLLAMA_BASE_URL=http://host.docker.internal:11434
# STRANDS_DECIDER_URL=
EXTERNAL_MCP_ENABLED=false
FEATURE_EXTERNAL_MCP=false

# --------------------------------------------------------------- notifications
NOTIFICATIONS_ENABLED=true
EMAIL_ADAPTER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025                 # container-internal Mailpit port; host capture is SMTP_CAPTURE_PORT
SMTP_AUTH_MODE=none            # none | password | oauth2
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
EMAIL_FROM=care@example.invalid
EMAIL_REPLY_TO=
SLACK_ADAPTER=bot
# Legacy alias for staff only; prefer SLACK_STAFF_BOT_TOKEN.
SLACK_BOT_TOKEN=
SLACK_STAFF_BOT_TOKEN=
SLACK_PATIENT_BOT_TOKEN=
SLACK_STAFF_WORKSPACE_ID=
SLACK_PATIENT_WORKSPACE_ID=
SLACK_ALLOWED_CHANNELS=
SLACK_PATIENT_ALLOWED_CHANNELS=
# Staff notify target: prefer allowlisted channel ID (C…). User IDs need an open bot DM.
TEST_STAFF_SLACK_ID=
TEST_PATIENT_SLACK_ID=
TEST_STAFF_EMAIL=
TEST_PATIENT_EMAIL=
NOTIFY_SEND_EXTERNAL=false
# Keycloak subject for staff_handoff / ops_alert (e.g. frontdesk.imran sub from seed).
NOTIFY_OPS_SUBJECT=
NOTIFY_MAX_RETRIES=3

# Secrets: env (default .env) | file (SECRETS_FILE=.env.json|.env) | vault (HashiCorp KV v2).
# Process env always wins over file/vault for a given key.
SECRETS_BACKEND=env
# SECRETS_FILE=
# VAULT_ADDR=https://vault.example:8200
# VAULT_TOKEN=
# VAULT_TOKEN_FILE=
# VAULT_SECRET_PATH=secret/data/sahyog
FEATURE_NOTIFICATIONS_SLACK_STAFF=true
FEATURE_NOTIFICATIONS_SLACK_PATIENT=true
FEATURE_FHIR_READ=true

# --------------------------------------------------------------------- analytics
ANALYTICS_ENABLED=true
ANALYTICS_REFRESH_CRON=15 2 * * *
ANALYTICS_SMALL_CELL_MINIMUM=5
ANALYTICS_STALE_AFTER_HOURS=30
INSIGHTS_ENABLED=true
INSIGHTS_SCHEDULE_CRON=30 2 * * *
FINANCE_MODEL_CONFIG=config/finops_model.yaml
USD_TO_INR_RATE=88
FX_RATE_DATE=2026-10-25

# ---------------------------------------------------------------- observability
# Leave empty in minimal. core/full set http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=sahyog-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_URL=http://localhost:5721
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_CAPTURE_CONTENT=false
# Browser-facing ops deep links / optional Grafana iframe on /ops (admin).
GRAFANA_PUBLIC_URL=http://localhost:5723
PROMETHEUS_PUBLIC_URL=http://localhost:5722
MAILPIT_PUBLIC_URL=http://localhost:5718
OBSERVABILITY_EMBED_GRAFANA=true
# Fraction of request traces exported to Langfuse. Content capture is always off.
TRACE_EXPORT_SAMPLE_RATIO=0.1
LANGFUSE_DATABASE_URL=postgresql://langfuse:replace-me@postgres:5432/langfuse
# First-boot bootstrap. The public/secret keys above must match these values;
# Langfuse creates the org, project, API key pair and UI user on startup.
LANGFUSE_INIT_ORG_ID=sahyog
LANGFUSE_INIT_ORG_NAME=Sahyog
LANGFUSE_INIT_PROJECT_ID=sahyog
LANGFUSE_INIT_PROJECT_NAME=Sahyog Care Companion
LANGFUSE_INIT_USER_EMAIL=admin@sahyog.local
LANGFUSE_INIT_USER_NAME=Sahyog Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me-strong-password
# Langfuse v2 (Postgres backend) application secrets. Generate with:
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=replace-me-32-plus-chars
LANGFUSE_SALT=replace-me-32-plus-chars
LANGFUSE_ENCRYPTION_KEY=replace-me-64-hex-chars

# ------------------------------------------------------------------- retention
RETENTION_AUDIO_HOURS=24
RETENTION_CHAT_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_NOTES_DAYS=365
RETENTION_EXPORT_DAYS=7

# ---------------------------------------------------------------- load testing
LOAD_TEST_AUTH=keycloak
LOAD_TEST_ALLOW_REAL_USERS=false
LOAD_TEST_TRAFFIC_CLASS=synthetic
LOAD_TEST_ABORT_REAL_P95_MS=2500
LOAD_TEST_ABORT_REAL_ERROR_RATE=0.02
LOAD_TEST_BUDGET_GUARD_USD=25
# G-22 drill: 1 injects an over-budget cost into the first guard sample (run stops with
# budget_guard, status kill_drill_passed; never capacity evidence). Keep 0 for real runs.
LOAD_TEST_KILL=0

# ------------------------------------------------------------ observability/full
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=replace-me

# --------------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:5706
VITE_API_PROXY=http://localhost:5706
VITE_DEV_PORT=5729
VITE_OIDC_AUTHORITY=http://localhost:5707/realms/sahyog
VITE_OIDC_CLIENT_ID=sahyog-web
# Compose web uses :5705; host Vite (start.sh --local) rewrites these to :5729.
VITE_OIDC_REDIRECT_URI=http://localhost:5705/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5705/
# Also allowlisted in Keycloak sahyog-web: http://localhost:5729/* (Vite HMR)
VITE_APP_ENV=dev
VITE_DEFAULT_LOCALE=en-IN
VITE_SUPPORTED_LOCALES=en-IN,hi-IN,mr-IN
